 111:Core/Src/main.c ****     ADCZZZ[x]=HAL_ADC_GetValue(&hadc1);
 112:Core/Src/main.c ****     x = (x + 1) % 16;
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****     uint32_t sum = 0;
 115:Core/Src/main.c ****     for (int i = 0; i < 16; i++) 
 116:Core/Src/main.c ****     {
 117:Core/Src/main.c ****       sum += ADCZZZ[i];
 118:Core/Src/main.c ****     }
 119:Core/Src/main.c ****     ADC_Value = sum / 16;
 120:Core/Src/main.c ****     if(ADC_Value > 2000 && ADC_Value < 2100) ADC_Value = 2048;
 121:Core/Src/main.c ****     V_Value =( 10*(float)ADC_Value / 4095.0 + 2.5)/ 10.0 * 2000;
 122:Core/Src/main.c ****     if(V_Value>2500) V_Value = 2500;
 123:Core/Src/main.c ****     if(V_Value<500) V_Value = 500;
 124:Core/Src/main.c ****     __HAL_TIM_SetCompare(&htim3,TIM_CHANNEL_2,V_Value);
 125:Core/Src/main.c ****     HAL_Delay(10);
